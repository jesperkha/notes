{
  "name": "notes-mock",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node app/db/migrate.mjs",
    "db:seed": "tsx app/db/seed.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "start": "pnpm db:migrate && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.44.0",
    "@lezer/highlight": "^1.2.5",
    "@react-router/node": "^7.9.2",
    "@react-router/serve": "^7.9.2",
    "@uiw/react-codemirror": "^4.25.13",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.31",
    "lucide-react": "^0.468.0",
    "postgres": "^4.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.2",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  },
  "packageManager": "pnpm@12.16.1"
}
