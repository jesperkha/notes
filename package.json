{
  "name": "notes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node app/db/migrate.mjs",
    "db:seed": "tsx app/db/seed.ts",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "start": "pnpm db:migrate && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.44.1",
    "@lezer/highlight": "^1.2.5",
    "@react-router/node": "^8.5.3",
    "@react-router/serve": "^8.5.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@uiw/react-codemirror": "^4.25.13",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.4",
    "lucide-react": "^1.81.0",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "packageManager": "pnpm@12.16.1"
}
